# Strategic Career Advancement Platform (SCAP) Environment Variables
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Database Mode: "auto", "oracle", or "sqlite"
# "auto" will try connecting to Oracle XE first. If unavailable, it smoothly falls back to SQLite.
DB_ENGINE=auto

# Oracle Database Configuration (XE 21c defaults)
ORACLE_USER=system
ORACLE_PASSWORD=oracle
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# Initial Admin Credentials (used during auto-seed)
ADMIN_EMAIL=admin@scap.edu
ADMIN_PASSWORD=Admin@SCAP2026
ADMIN_NAME=Platform Administrator
